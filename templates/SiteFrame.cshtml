@inherits Chloroplast.Core.Rendering.ChloroplastTemplateBase<Chloroplast.Core.Rendering.FrameRenderedContent>
<!doctype html>
<html lang="en" data-theme="day">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content="@Model.GetMeta("description")" />
<meta name="theme-color" content="#fbf3e0" />
<meta name="robots" content="noindex, nofollow" />
<title>@Model.GetMeta("title") · Cercano + Cercloud Docs</title>
<link rel="icon" href="@Asset("/assets/favicon.svg")" type="image/svg+xml" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&amp;display=swap" rel="stylesheet" />
<link rel="stylesheet" href="@Asset("/assets/brand.css")" />
<link rel="stylesheet" href="@Asset("/assets/docs.css")" />
<script>
(() => { try { const saved = localStorage.getItem("cercloud-theme");
const preferred = matchMedia("(prefers-color-scheme: dark)").matches ? "night" : "day";
document.documentElement.dataset.theme = saved || preferred;
} catch (_) { document.documentElement.dataset.theme = "day"; } })();
</script>
<script src="@Asset("/assets/theme.js")" defer></script>
<script src="@Asset("/assets/docs.js")" defer></script>
</head>
<body data-base="@Href("/")">
<a class="skip-link" href="#main">Skip to content</a>
<div class="docs-shell">
<header class="site-header">
<a class="brand" href="@Href("/")" aria-label="Cercloud documentation home"><img class="brand-mark" src="@Asset("/assets/favicon.svg")" alt="" width="24" height="24" /><span>cercloud</span><span class="brand-suffix">/ docs</span></a>
<nav class="primary-nav" aria-label="Primary navigation">
<a href="https://cercano-ai.github.io/Cercano/">Cercano</a>
<a href="https://cercano-ai.github.io/cercloud-site/">Cercloud</a>
<button class="theme-toggle" type="button" aria-label="Switch to night theme" aria-pressed="false"><span class="theme-name">Day</span><span class="theme-track" aria-hidden="true"><span></span></span></button>
</nav>
</header>
<div class="mobile-tools"><button id="menu-toggle" aria-expanded="false" aria-controls="sidebar">Browse documentation</button></div>
<div class="docs-layout">
<aside id="sidebar" class="sidebar">
<form role="search" class="search-form"><label for="search">Search documentation</label><div class="search-input"><input id="search" type="search" autocomplete="off" placeholder="Search docs…" aria-controls="search-results" /><kbd>/</kbd></div><p id="search-status" class="sr-only" aria-live="polite"></p><ul id="search-results" hidden></ul></form>
<nav aria-label="Documentation">@await PartialAsync("Navigation", Model)</nav>
<div class="sidebar-foot">Two products.<br />One working environment.</div>
</aside>
<main class="content">@Raw(Model.Body)</main>
<aside class="toc" aria-label="On this page"><p>On this page</p><nav id="toc-links"></nav><a class="review-link" href="@Href("/about-this-draft/")">About this draft</a></aside>
</div>
</div>
</body>
</html>
